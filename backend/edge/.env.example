# Edge local env. Copy to .env (gitignored) and replace every change-me. Never commit real values (D32).
EDGE_POSTGRES_PASSWORD=change-me
JWT_SIGNING_SECRET=change-me
JWT_AUDIENCE=zord-console
JWT_ISSUER=zord-edge
RELAY_AUTH_TOKEN=change-me
# Guards POST /v1/admin/roles/grant (PLATFORM_ADMIN / PAYOUT_APPROVER / CONNECTOR_ADMIN). Empty = endpoint fails closed.
INTERNAL_ADMIN_KEY=change-me
ZORD_VAULT_KEY=change-me
# Encrypts connector/webhook secrets at rest (enc:v1:). Standard base64 of 32
# random bytes: `openssl rand -base64 32`. Required: without it webhooks and
# connector creation return 503. Rotating it needs cmd/reencrypt-secrets.
CLEARLINE_SECRETS_KEY=change-me
# true/1 for MinIO/LocalStack (path-style URLs). Default false = AWS.
S3_FORCE_PATH_STYLE=false
