# Airflow (Clearline scheduler) local env. Copy to .env (gitignored) and
# replace every change-me. Never commit real values (D32).
AIRFLOW_UID=50000
AIRFLOW_POSTGRES_PASSWORD=change-me
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
AIRFLOW_INTERNAL_API_SECRET_KEY=change-me
AIRFLOW_WEBSERVER_SECRET_KEY=change-me
AIRFLOW__API_AUTH__JWT_SECRET=change-me
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me
# Must match recon/edge RELAY_AUTH_TOKEN (X-Relay-Token on /internal/* calls).
RELAY_AUTH_TOKEN=change-me
SCHEDULER_KAFKA_BOOTSTRAP_SERVERS=broker1:9092,broker2:9093,broker3:9094
SCHEDULER_KAFKA_GROUP_ID=clearline-signal-scheduler
