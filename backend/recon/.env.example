# Recon (outcome engine) local env. Copy to .env (gitignored) and replace every change-me. Never commit real values (D32).
RECON_POSTGRES_PASSWORD=change-me
RELAY_AUTH_TOKEN=change-me
JWT_SIGNING_SECRET=change-me
ZORD_VAULT_KEY=change-me
# Per-tenant Razorpay credentials come from edge's connector store; no shared fallback key (D32).
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# true/1 for MinIO/LocalStack (path-style URLs). Default false = AWS.
S3_FORCE_PATH_STYLE=false
