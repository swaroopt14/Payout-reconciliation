# Router local env. Copy to .env (gitignored) and replace every change-me. Never commit real values (D32).
ROUTER_POSTGRES_PASSWORD=change-me
# Callers (relay, console) must send this token, or every payout holds.
ROUTER_AUTH_TOKEN=change-me
JWT_SIGNING_SECRET=change-me
# Must equal the aud edge mints.
JWT_AUDIENCE=zord-console
JWT_ISSUER=zord-edge
# Service URL callers use (container-internal).
ROUTER_URL=http://zord-router:8091
