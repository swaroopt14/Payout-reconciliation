# Payout smoke simulator local env. Copy to .env (gitignored) and replace every change-me. Never commit real values (D32).
# The previously committed Postgres password must be treated as leaked and rotated.
SMOKE_POSTGRES_PASSWORD=change-me
# Format: user:password[,user:password]
ZORD_LOGIN_USERS=change-me:change-me
SMOKE_API_KEY=change-me
