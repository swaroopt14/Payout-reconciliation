# Relay local env. Copy to .env (gitignored) and replace every change-me.
# Never commit real values (D32).
RELAY_AUTH_TOKEN=change-me
RELAY_OPERATOR_AUTH_TOKEN=change-me
RELAY_POSTGRES_PASSWORD=change-me
# Router: container-internal service URL (not the host port).
ROUTER_URL=http://zord-router:8091
ROUTER_AUTH_TOKEN=change-me
