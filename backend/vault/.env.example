# Vault local env. Copy to .env (gitignored) and replace every change-me. Never commit real values (D32).
VAULT_POSTGRES_PASSWORD=change-me
SERVICE_JWT_SIGNING_SECRET=change-me
TOKEN_SECRET=change-me
# KMS key ARN/alias for this environment (never commit a real ARN).
KMS_KEY_ID=change-me
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
KAFKA_BROKERS=
KAFKA_TOPIC_PII_TOKENIZE_REQUEST=
KAFKA_TOPIC_PII_TOKENIZE_RESULT=
KAFKA_TOPIC_PII_TOKENIZE_REQUEST_DLQ=
