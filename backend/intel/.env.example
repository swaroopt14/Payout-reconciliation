# Intelligence local env. Copy to .env (gitignored) and replace every change-me. Never commit real values (D32).
INTEL_POSTGRES_PASSWORD=change-me
JWT_SIGNING_SECRET=change-me
# docker-compose.test.yml defaults to test-only values; override if needed.
INTEL_TEST_POSTGRES_PASSWORD=test-only-db-password
INTEL_TEST_JWT_SIGNING_SECRET=test-only-jwt-signing-secret-not-for-production
